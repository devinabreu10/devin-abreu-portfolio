{
  "name": "portfolio-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for portfolio static website",
  "main": "bin/portfolio-infrastructure.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:prod": "cdk deploy",
    "deploy:local": "cdklocal deploy --context useLocalStack=true",
    "destroy:prod": "cdk destroy",
    "destroy:local": "cdklocal destroy --context useLocalStack=true",
    "synth": "cdk synth",
    "synth:local": "cdk synth --context useLocalStack=true"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "aws-cdk": "2.100.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.100.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
